            result.push('<tr>');
            cells.forEach(function(cell) {
                result.push('<td>' + cell + '</td>');
            });
            result.push('</tr>');
        } else {
            if (inTable) {
                result.push('</tbody></table>');
                inTable = false;
            }
            result.push(line);
        }
    }
    if (inTable) result.push('</tbody></table>');
    html = result.join('\n');
