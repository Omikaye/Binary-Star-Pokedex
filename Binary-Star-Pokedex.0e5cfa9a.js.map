    ]);
    var hazardsMoveIds = makeIdTable([
        'defog',
        'rapidspin',
        'spikes',
        'stealthrock',
        'stickyweb',
        'toxicspikes'
    ]);
    var phazingMoveIds = makeIdTable([
        'circlethrow',
        'dragontail',
